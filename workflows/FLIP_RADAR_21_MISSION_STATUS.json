      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Modifier uniquement ces parametres NON SECRETS.\nconst worker_url = 'https://YOUR-FLIP-RADAR-WORKER';\nconst chat_id = 'YOUR_TELEGRAM_CHAT_ID';\nconst mission_id = 'YOUR_MISSION_UUID';\nconst listing_id = 'YOUR_LISTING_UUID';\nif(worker_url.includes('YOUR-'))throw new Error('CONFIGURER_URL_WORKER_AVANT_EXECUTION');\n// URL is not a global in all n8n runners. Only accept an HTTPS DNS origin here.\nif(!/^https:\\/\\/(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63}(?::443)?\\/?$/i.test(worker_url))throw new Error('URL_WORKER_HTTPS_ORIGIN_REQUIRED');\nreturn [{json:{worker_url:worker_url.replace(/\\/$/,''),chat_id,mission_id,listing_id}}];"
      }
    },
    {
      "id": "0e13f243-b646-4d7c-a5ff-6866b074381b",
      "name": "Verifier identifiant",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const c=$input.first().json;if(!/^[0-9a-f-]{36}$/i.test(c.mission_id))throw new Error('CONFIGURER_MISSION_UUID');return [{json:c}];"
      }
    },
    {
      "id": "0e0a0fa9-99e5-4958-a9c9-01bfa571a96d",
      "name": "Lire etat",
      "type": "n8n-nodes-base.httpRequest",
