      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const worker_url = 'https://flip-radar-production-1c7c.up.railway.app';\nconst countries = ['AL','AD','AT','BE','BA','BG','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','XK','LV','LI','LT','LU','MT','MD','MC','ME','NL','MK','NO','PL','PT','RO','SM','RS','SK','SI','ES','SE','CH','TR','UA','GB','VA'];\nconst languages = ['fr','en','de','es','it','nl','pt','pl'];\nconst objective = [\n  'Chercher sur les sources europeennes explicitement approuvees des annonces sous-cotees pour achat-revente.',\n  'Explorer toutes les familles de produits autorisees sans plafond fixe de prix achat.',\n  'Prioriser les produits identifiables avec clientele active, rotation rapide, marge nette potentielle et concurrence supportable.',\n  'Varier les requetes, synonymes, langues, fautes courantes, modeles et pays selon les resultats visibles.',\n  'Sauvegarder uniquement les annonces dont le titre et le prix sont visibles et ne jamais inventer ventes, demande, frais ou authenticite.',\n  'Ne jamais acheter, contacter un vendeur, se connecter, contourner un blocage ou remplir un formulaire.'\n].join(' ');\nreturn [{json:{worker_url,countries,languages,objective,started_at:new Date().toISOString()}}];"
      }
