        "jsCode": "const mission=$('Lire etat final').first().json;\nconst listings=$('Lire annonces').first().json.listings||[];\nconst opportunities=$input.first().json.opportunities||[];\nconst startedAt=Date.parse($('Configuration Europe').first().json.started_at);\nconst fresh=listings.filter(x=>Date.parse(x.observed_at)>=startedAt);\nconst counts={GO:0,REVUE:0,SURVEILLER:0,NON:0};\nfor(const o of opportunities)if(Object.hasOwn(counts,o.verdict))counts[o.verdict]++;\nreturn [{json:{project:'FLIP RADAR',workflow_version:'1.0.0',worker:'online',mission,raw_candidates_total:listings.length,raw_candidates_this_execution:fresh.length,opportunities_total:opportunities.length,verdicts:counts,latest_candidates:listings.slice(0,20),latest_opportunities:opportunities.slice(0,20),human_validation_required:true,purchases_executed:0,seller_messages_sent:0,warning:'Une annonce brute ou un score ne garantit ni revente ni benefice. Verifier etat, authenticite, disponibilite, frais et preuves avant tout achat manuel.'}}];"
