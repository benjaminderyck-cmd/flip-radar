      "name": "Configuration",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const worker_url='https://flip-radar-production-1c7c.up.railway.app';\nconst confirm_pending_only=true;\nif(!/^https:\\/\\/(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63}(?::443)?\\/?$/i.test(worker_url))throw new Error('URL_WORKER_HTTPS_ORIGIN_REQUIRED');\nif(confirm_pending_only!==true)throw new Error('CONFIRMATION_REQUIRED');\nreturn [{json:{worker_url:worker_url.replace(/\\/$/,''),confirm_pending_only}}];"
      }
    },
    {
      "id": "282dd4d7-de07-4382-af25-c2ac3644cc0b",
      "name": "Enregistrer sources en attente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuration').first().json.worker_url + '/v1/sources/catalog/import' }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({confirm_pending_only:$json.confirm_pending_only}) }}",
        "options": {
          "timeout": 30000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": false,
      "onError": "stopWorkflow",
      "notes": "Credential Header Auth FLIP_RADAR_REVIEW obligatoire. Ce noeud enregistre le catalogue fourni avec le worker, mais n active aucune source."
    },
